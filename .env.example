# Frontend Deployment Environment Variables
# For Render deployment, VITE_API_URL points to your backend Render URL:
VITE_API_URL=https://ethio-lingo.onrender.com/api/v1

# Optional: Landing Page Explainer YouTube Video (accepts full YouTube URL or 11-char video ID)
VITE_LANDING_VIDEO_URL=https://www.youtube.com/watch?v=dQw4w9WgXcQ

# Google Identity Services OAuth Client ID (must match server GOOGLE_CLIENT_ID).
# Required to render the "Continue with Google" / "Verify with Google" buttons.
VITE_GOOGLE_CLIENT_ID=<your-google-oauth-client-id.apps.googleusercontent.com>

# Supabase (used by the client for auth/storage; publishable key is safe to expose)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>


