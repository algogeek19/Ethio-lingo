# Backend Deployment Environment Variables for Render
PORT=5000
NODE_ENV=production
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
JWT_SECRET=<generate-a-long-random-secret-string>
# Google OAuth (ID-token verification for email verification / Google sign-in)
GOOGLE_CLIENT_ID=<your-google-oauth-client-id.apps.googleusercontent.com>
# Supabase (also set SUPABASE_URL accordingly)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>
SUPABASE_SECRET_KEY=sb_secret_<your-service-role-secret-key>
# GeezSMS — announcements are delivered by SMS (see docs/GEEZSMS_SETUP.md)
GEEZSMS_BASE_URL=https://api.geezsms.com/api/v1
GEEZSMS_TOKEN=<your-geezsms-api-token>
GEEZSMS_SENDER_ID=<your-registered-sender-id-or-shortcode>   # Optional
# Mailtrap — transactional email (verification codes). Unset means email
# verification codes are generated but cannot be delivered, and a password
# signup cannot be verified. Set both on the API service.
# Staging and production use the same endpoint, so the flow can be exercised
# against a Mailtrap inbox before a real sender domain exists.
MAILTRAP_TOKEN=<your-mailtrap-api-token>
MAILTRAP_FROM_EMAIL=no-reply@<your-domain>            # must be a verified sender
MAILTRAP_FROM_NAME=Ethio-Lingo                        # Optional
MAILTRAP_HOST=https://send.api.mailtrap.io             # Optional (EU accounts)
# Extra browser origins allowed to call the API (comma-separated).
# The project's own frontends (https://ethio-lingo-w1bc.onrender.com,
# https://ethio-lingo.onrender.com, https://birrend.onrender.com,
# https://birrendserver.onrender.com) and localhost are ALWAYS allowed and
# cannot be removed from this list — this variable only adds to them.
CORS_ORIGIN=https://ethio-lingo.onrender.com,https://birrend.onrender.com,https://birrendserver.onrender.com,http://localhost:5173

