# Backend Deployment Environment Variables for Render
PORT=5000
NODE_ENV=production
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
JWT_SECRET=<generate-a-long-random-secret-string>
# Supabase (also set SUPABASE_URL accordingly)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>
SUPABASE_SECRET_KEY=sb_secret_<your-service-role-secret-key>
# Allowed frontend production domains for CORS on Render
CORS_ORIGIN=https://ethio-lingo.onrender.com,https://birrend.onrender.com,https://birrendserver.onrender.com,http://localhost:5173

